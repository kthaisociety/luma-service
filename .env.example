# Bind address. Empty (the default) binds all interfaces, which the container needs. Keep 127.0.0.1
# for local dev: anything on 0.0.0.0 on a machine with a public IP is reachable from the internet.
HOST=127.0.0.1
# 8001 locally so it doesn't clash with growth-portal on 8000. The image listens on 8000.
PORT=8001

# Postgres; `docker compose up -d` starts this one.
DATABASE_URL=postgres://luma:luma@127.0.0.1:5434/luma?sslmode=disable

# Shared secret every caller sends as X-Service-Secret. Generate with: openssl rand -base64 32
# growth-portal's LUMA_SERVICE_SECRET must be the same value.
LUMA_SERVICE_SECRET=<LUMA_SERVICE_SECRET>

# A Luma calendar API key (Luma dashboard → calendar → Settings → Developer). The key decides which
# calendar is read: there is no calendar ID setting. Use a test calendar's key locally if you can.
LUMA_API_KEY=<LUMA_API_KEY>

# The membership tier served at /v1/community/members (the "Community" tier). List the calendar's
# tiers and their IDs with GET /v1/tiers.
LUMA_COMMUNITY_TIER_ID=<LUMA_COMMUNITY_TIER_ID>
